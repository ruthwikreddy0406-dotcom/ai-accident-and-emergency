# RoadGuard AI Configuration

# Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Database (PostgreSQL or local SQLite fallback)
DATABASE_URL=sqlite:///roadguard.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/roadguard_ai

# Security
SECRET_KEY=roadguard-super-secret-key-production-grade-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Model & Computer Vision Hyperparameters
MODEL_PATH=models/yolov8n.pt
DETECTION_CONFIDENCE=0.40
COLLISION_IOU_THRESHOLD=0.25
COLLISION_DECEL_THRESHOLD=22.0
COLLISION_WINDOW_FRAMES=15

# Upload & Evidence Limits
MAX_UPLOAD_SIZE_MB=150

# Demo Mode & Safety Guardrails
DEMO_MODE=true
SIMULATE_EMERGENCY_DISPATCH=true
